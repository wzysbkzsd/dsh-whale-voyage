{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "web",
    "rootDir": "web-src",
    "sourceMap": false
  },
  "include": ["web-src/app.ts", "web-src/escape.ts", "web-src/i18n.ts", "web-src/inbox-logic.ts", "web-src/share.ts", "web-src/skin.ts"]
}
